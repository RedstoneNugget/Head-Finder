{
  "schemaVersion": 1,
  "id": "head_finder",
  "version": "${version}",
  "name": "Head Finder",
  "description": "Erkennt die Event-Köpfe in geladenen Chunks, zeigt ihre Koordinaten in einer Liste, markiert sie und führt dich per Pfeil hin. Gefundene Köpfe werden abgehakt. Rein clientseitig.",
  "authors": ["redstone_nugget"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.headfinder.HeadFinderClient"],
    "modmenu": ["com.headfinder.compat.ModMenuIntegration"]
  },
  "mixins": ["head_finder.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
